# MongoDB connection string used by the app (server-side only — never sent
# to the browser). Get this from MongoDB Atlas (or your own MongoDB
# instance).
#
# Example (Atlas, SRV form):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio?retryWrites=true&w=majority
#
# Example (local MongoDB):
# MONGODB_URI=mongodb://127.0.0.1:27017/portfolio
#
# If you see "querySrv ETIMEOUT" / "querySrv ECONNREFUSED" errors, your
# network's DNS resolver can't resolve the SRV record the mongodb+srv://
# form depends on (common on some corporate networks, VPNs and restrictive
# firewalls). The most reliable fix is to switch to the non-SRV "standard
# connection string" instead — in Atlas: Database > Connect > Drivers >
# "Standard connection string" — which lists the actual hosts directly and
# skips the SRV DNS lookup entirely:
# MONGODB_URI=mongodb://<user>:<password>@host1.mongodb.net:27017,host2.mongodb.net:27017,host3.mongodb.net:27017/portfolio?replicaSet=<name>&retryWrites=true&w=majority&tls=true
#
# Alternatively, you can point DNS resolution at a resolver known to work
# without changing the URI at all:
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

MONGODB_URI=
